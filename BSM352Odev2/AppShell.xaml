<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BSM352Odev2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BSM352Odev2"
    Shell.FlyoutBehavior="Flyout">

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="15,10">
                <Label Text="{Binding Title}"
                       FontSize="16"
                       VerticalOptions="Center"
                       HorizontalOptions="Start" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <FlyoutItem Title="Ana Sayfa" >
        <ShellContent
            Title="Ana Sayfa"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Kredi Hesaplama" >
        <ShellContent
            Title="Kredi Hesaplama"
            ContentTemplate="{DataTemplate local:KrediHesaplamaPage}"
            Route="KrediHesaplamaPage" />
    </FlyoutItem>

    <FlyoutItem Title="Vücut Kitle İndeksi" >
        <ShellContent
            Title="VKİ Hesaplama"
            ContentTemplate="{DataTemplate local:VkiHesaplamaPage}"
            Route="VkiHesaplamaPage" />
    </FlyoutItem>

    <FlyoutItem Title="Renk Seçici" >
        <ShellContent
            Title="Renk Seçici"
            ContentTemplate="{DataTemplate local:RenkSeciciPage}"
            Route="RenkSeciciPage" />
    </FlyoutItem>

</Shell>