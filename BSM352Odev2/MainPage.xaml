<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BSM352Odev2.MainPage"
             Title="Ana Sayfa"
             BackgroundColor="Goldenrod">

    <ScrollView>
        <VerticalStackLayout 
            Padding="30,0"
            Spacing="25"
            VerticalOptions="Center">

            <Image
                Source="batin.jpeg"
                HeightRequest="400"
                WidthRequest="300"
                HorizontalOptions="Center"
                SemanticProperties.Description="Öğrenci profil resmi"
                Aspect="AspectFill" />

            <Label 
                x:Name="LblAdSoyad"
                Text="MUSTAFA BATIN KAYNAK" 
                FontSize="22"
                FontAttributes="Bold"
                HorizontalOptions="Center" 
                SemanticProperties.HeadingLevel="Level1" />

            <Label 
                Text="Bartın Üniversitesi Bilgisayar Mühendisliği"
                FontSize="16"
                HorizontalOptions="Center" />

            <Label 
                Text="BSM352 - Görsel Programlama Ödev 2"
                FontSize="14"
                FontAttributes="Italic"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>